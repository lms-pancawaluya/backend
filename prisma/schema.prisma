datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS (Daftar Pilihan Tetap)
// ==========================================

enum Role {
  admin
  guru
  pengajar // TAMBAHAN: Role Trainer/Pengajar
}

enum AspekPancawaluya {
  cageur
  bageur
  bener
  pinter
  singer
  umum // TAMBAHAN: Supaya fleksibel kalau ada modul tambahan
}

enum ContentType {
  teks
  video
}

enum QuestionType {
  pilihan_ganda
}

enum ProgressStatus {
  belum_mulai
  sedang_belajar
  selesai
}

enum UserStatus {
  aktif
  nonaktif
  pensiun
  wafat
}

enum RtlStatus {
  pending
  disetujui
  ditolak
}

// ==========================================
// TABEL DATABASE (MODELS)
// ==========================================

model User {
  id           String     @id @default(uuid())
  nama         String
  email        String     @unique
  password     String
  role         Role       @default(guru)
  status       UserStatus @default(aktif) @map("status")
  nip          String?    @unique @map("nip")        
  sekolah      String?    @map("sekolah")        
  kotaKab      String?    @map("kota/kab")    // SESUAI SUPABASE
  kecamatan    String?    @map("kecamatan")
  noHp         String?    @map("no_hp")         
  fotoProfil   String?    @map("foto_profil") 
  isVerified   Boolean    @default(false) @map("is_verified")
  otpCode      String?    @map("otp_code") 
  otpExpiresAt DateTime?  @map("otp_expires_at")
  gelar        String?    @map("gelar")
  createdAt    DateTime   @default(now()) @map("created_at")

  // Relasi
  progress         user_progress[]
  answers          user_answers[]
  miniQuizAttempts MiniQuizAttempt[]
  feedbacks        Feedback[]
  comments         Comment[]        // TAMBAHAN: Komentar di materi/video
  rtlSubmissions   RtlSubmission[]  // TAMBAHAN: Upload RTL
  reviewedRtls     RtlSubmission[]  @relation("TrainerRtlReviewer") // RTL yang dinilai pengajar
  createdMeetings  Meeting[]        @relation("CreatedMeetings")   // Meeting yang dibuat pengajar

  tickets       Ticket[]        @relation("UserTickets")
  ticketReplies TicketReply[]   @relation("UserTicketReplies")
  @@map("users")
}

model Module {
  id               String            @id @default(uuid())
  judul            String
  deskripsi        String            @db.Text
  aspekPancawaluya AspekPancawaluya? @default(umum) @map("aspek_pancawaluya") // REVISI: Dibuat opsional agar modul bebas
  urutan           Int
  createdAt        DateTime          @default(now()) @map("created_at")

  // Relasi ke tabel lain
  contents       Content[]
  evaluations    Evaluation[]
  progress       user_progress[]
  feedbacks      Feedback[]
  rtlSubmissions RtlSubmission[] // TAMBAHAN: RTL terikat pada modul
  comments       Comment[]

  @@map("modules")
}

model Content {
  id        String      @id @default(uuid())
  moduleId  String      @map("module_id")
  judul     String
  tipe      ContentType
  konten    String      @db.Text // Teks Materi ATAU Link YouTube
  urutan    Int
  createdAt DateTime    @default(now()) @map("created_at")

  // Relasi
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  miniQuizzes MiniQuiz[] 

  @@map("contents")
}

model Evaluation {
  id           String   @id @default(uuid())
  moduleId     String   @map("module_id")
  judul        String
  passingScore Int      @default(80) @map("passing_score")
  maxAttempts  Int      @default(3) @map("max_attempts")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relasi
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("evaluations")
}

model Question {
  id           String       @id @default(uuid())
  evaluationId String       @map("evaluation_id")
  pertanyaan   String       @db.Text
  tipe         QuestionType @default(pilihan_ganda)
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relasi
  evaluation Evaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  options    Option[]
  answers    user_answers[]

  @@map("questions")
}

model Option {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  teksOpsi   String  @map("teks_opsi") @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  // Relasi
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model user_progress {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  moduleId    String         @map("module_id")
  status      ProgressStatus @default(belum_mulai)
  skor        Int?           @default(0)
  attempts    Int            @default(0)
  completedAt DateTime?      @map("completed_at")

  // Relasi
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_progress")
}

model user_answers {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  questionId String  @map("question_id")
  jawaban   String   @db.Text
  isCorrect Boolean? @map("is_correct")
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId]) 
  @@map("user_answers")
}

// ==========================================
// TABEL FEEDBACK
// ==========================================

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  saran     String   @db.Text
  kritik    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

// ==========================================
// FITUR KOMENTAR (POIN 4)
// ==========================================

model Comment {
  id        String   @id @default(uuid())
  moduleId  String   @map("module_id")
  userId    String   @map("user_id")
  komentar  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi mengarah ke Module
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ==========================================
// FITUR UPLOAD RTL & SERTIFIKAT (POIN 3 & 7)
// ==========================================

model RtlSubmission {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  moduleId      String    @map("module_id")
  filePdfUrl    String    @map("file_pdf_url") @db.Text
  catatanGuru   String?   @map("catatan_guru") @db.Text
  status        RtlStatus @default(pending)
  catatanTrainer String?  @map("catatan_trainer") @db.Text
  reviewedById  String?   @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relasi
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("TrainerRtlReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, moduleId])
  @@map("rtl_submissions")
}

// ==========================================
// FITUR JADWAL VIRTUAL MEETING (POIN 5 & 6)
// ==========================================

model Meeting {
  id           String   @id @default(uuid())
  judul        String
  deskripsi    String?  @db.Text
  linkMeeting  String   @map("link_meeting") @db.Text // Link Zoom / GMeet
  waktuMulai   DateTime @map("waktu_mulai")
  waktuSelesai DateTime @map("waktu_selesai")
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relasi
  createdBy User @relation("CreatedMeetings", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("meetings")
}

// ==========================================
// MINI QUIZ
// ==========================================

model MiniQuiz {
  id               String   @id @default(uuid())
  contentId        String   @map("content_id")
  judul            String
  timestampSeconds Int?     @map("timestamp_seconds")
  passingScore     Int      @default(80) @map("passing_score")
  maxAttempts      Int      @default(3) @map("max_attempts")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relasi
  content   Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  questions MiniQuizQuestion[]
  attempts  MiniQuizAttempt[]

  @@map("mini_quizzes")
}

model MiniQuizQuestion {
  id         String   @id @default(uuid())
  miniQuizId String   @map("mini_quiz_id")
  pertanyaan String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relasi
  miniQuiz MiniQuiz         @relation(fields: [miniQuizId], references: [id], onDelete: Cascade)
  options  MiniQuizOption[]

  @@map("mini_quiz_questions")
}

model MiniQuizOption {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  teksOpsi   String  @map("teks_opsi") @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  // Relasi
  question MiniQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("mini_quiz_options")
}

model MiniQuizAttempt {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  miniQuizId    String   @map("mini_quiz_id")
  attemptNumber Int      @map("attempt_number")
  skor          Int
  isLolos       Boolean  @map("is_lolos")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  miniQuiz MiniQuiz @relation(fields: [miniQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, miniQuizId, attemptNumber])
  @@map("mini_quiz_attempts")
}

// ==========================================
// FITUR HELPDESK / TICKETING
// ==========================================

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String       @unique @map("ticket_number")
  userId       String       @map("user_id")
  subject      String
  category     String
  description  String       @db.Text
  status       TicketStatus @default(open)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Diberi nama relasi "UserTickets" sesuai dengan yang ada di model User
  user    User          @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  @@map("tickets")
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  senderId  String   @map("sender_id")
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Diberi nama relasi "UserTicketReplies" sesuai dengan yang ada di model User
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation("UserTicketReplies", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}