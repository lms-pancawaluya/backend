datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS (Daftar Pilihan Tetap)
// ==========================================

enum Role {
  admin
  guru
}

enum AspekPancawaluya {
  cageur
  bageur
  bener
  pinter
  singer
}

enum ContentType {
  teks
  video
}

// ⚠️ MODIFIKASI: Menghapus 'esai' agar Evaluasi murni Pilihan Ganda
enum QuestionType {
  pilihan_ganda
}

enum ProgressStatus {
  belum_mulai
  sedang_belajar
  selesai
}

enum UserStatus {
  aktif
  nonaktif
  pensiun
  wafat
}

// ==========================================
// TABEL DATABASE (MODELS)
// ==========================================

model User {
  id           String     @id @default(uuid())
  nama         String
  email        String     @unique
  password     String
  role         Role       @default(guru)
  status       UserStatus @default(aktif) @map("status")
  nip          String?    @unique @map("nip")        
  sekolah      String?    @map("sekolah")        
  noHp         String?    @map("no_hp")         
  fotoProfil   String?    @map("foto_profil") 
  isVerified   Boolean    @default(false) @map("is_verified")
  otpCode      String?    @map("otp_code") 
  otpExpiresAt DateTime?  @map("otp_expires_at")
  gelar        String?    @map("gelar")
  createdAt    DateTime   @default(now()) @map("created_at")

  progress         user_progress[]
  answers          user_answers[]
  dailyChecklists  DailyChecklist[]
  miniQuizAttempts MiniQuizAttempt[]
  feedbacks        Feedback[]        // ⚠️ RELASI BARU: Ke Tabel Feedback

  @@map("users")
}

model Module {
  id               String           @id @default(uuid())
  judul            String
  deskripsi        String           @db.Text
  aspekPancawaluya AspekPancawaluya @map("aspek_pancawaluya")
  urutan           Int
  createdAt        DateTime         @default(now()) @map("created_at")

  // Relasi ke tabel lain
  contents    Content[]
  evaluations Evaluation[]
  progress    user_progress[]
  feedbacks   Feedback[]            // ⚠️ RELASI BARU: Ke Tabel Feedback

  @@map("modules")
}

model Content {
  id             String      @id @default(uuid())
  moduleId       String      @map("module_id")
  judul          String
  tipe           ContentType
  konten         String      @db.Text
  urutan         Int
  showQuizAtSec  Int?        @map("show_quiz_at_sec") // ⚠️ FIELD BARU: Menit/detik munculnya mini quiz video
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relasi balik ke Module
  module   Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  miniQuiz MiniQuiz?

  @@map("contents")
}

model Evaluation {
  id           String   @id @default(uuid())
  moduleId     String   @map("module_id")
  judul        String
  passingScore Int      @default(80) @map("passing_score") // ⚠️ FIELD BARU: Minimal nilai (80%)
  maxAttempts  Int      @default(3) @map("max_attempts")   // ⚠️ FIELD BARU: Batas gagal (3x)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relasi balik ke Module
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("evaluations")
}

model Question {
  id           String       @id @default(uuid())
  evaluationId String       @map("evaluation_id")
  pertanyaan   String       @db.Text
  tipe         QuestionType @default(pilihan_ganda)
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relasi
  evaluation Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  options    Option[]
  answers    user_answers[]

  @@map("questions")
}

model Option {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  teksOpsi   String  @map("teks_opsi") @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  // Relasi
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model user_progress {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  moduleId    String         @map("module_id")
  status      ProgressStatus @default(belum_mulai)
  skor        Int?           @default(0)  // ⚠️ FIELD BARU: Menyimpan skor evaluasi akhir
  attempts    Int            @default(0)  // ⚠️ FIELD BARU: Menghitung berapa kali percobaan
  completedAt DateTime?      @map("completed_at")

  // Relasi
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("user_progress")
}

model user_answers {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  jawaban    String   @db.Text
  isCorrect  Boolean? @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId]) 
  @@map("user_answers")
}

// ==========================================
// TABEL BARU: SARAN & KRITIK (FEEDBACK)
// ==========================================

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  saran     String   @db.Text
  kritik    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

// ==========================================
// DAILY CHECKLIST
// ==========================================

model ChecklistItem {
  id        String           @id @default(uuid())
  aspek     AspekPancawaluya
  deskripsi String           @db.Text
  urutan    Int
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relasi
  dailyChecklists DailyChecklist[]

  @@map("checklist_items")
}

model DailyChecklist {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  checklistItemId String   @map("checklist_item_id")
  tanggal         DateTime @db.Date
  isChecked       Boolean  @default(false) @map("is_checked")
  fotoBukti       String?  @map("foto_bukti") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  // Relasi
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistItemId, tanggal])
  @@map("daily_checklist")
}

// ==========================================
// MINI QUIZ
// ==========================================

model MiniQuiz {
  id           String   @id @default(uuid())
  contentId    String   @unique @map("content_id")
  judul        String
  passingScore Int      @default(80) @map("passing_score")
  maxAttempts  Int      @default(3) @map("max_attempts")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relasi
  content  Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  questions MiniQuizQuestion[]
  attempts MiniQuizAttempt[]

  @@map("mini_quizzes")
}

model MiniQuizQuestion {
  id         String   @id @default(uuid())
  miniQuizId String   @map("mini_quiz_id")
  pertanyaan String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relasi
  miniQuiz MiniQuiz         @relation(fields: [miniQuizId], references: [id], onDelete: Cascade)
  options  MiniQuizOption[]

  @@map("mini_quiz_questions")
}

model MiniQuizOption {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  teksOpsi   String  @map("teks_opsi") @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  // Relasi
  question MiniQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("mini_quiz_options")
}

model MiniQuizAttempt {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  miniQuizId    String   @map("mini_quiz_id")
  attemptNumber Int      @map("attempt_number")
  skor          Int
  isPassed      Boolean  @map("is_passed")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  miniQuiz MiniQuiz @relation(fields: [miniQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, miniQuizId, attemptNumber])
  @@map("mini_quiz_attempts")
}