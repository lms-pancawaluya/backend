datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS (Daftar Pilihan Tetap)
// ==========================================

enum Role {
  admin
  guru
  pengajar
}

enum AspekPancawaluya {
  cageur
  bageur
  bener
  pinter
  singer
  umum
}

enum ContentType {
  teks
  video
}

enum QuestionType {
  pilihan_ganda
}

enum ProgressStatus {
  belum_mulai
  sedang_belajar
  selesai
}

enum UserStatus {
  aktif
  nonaktif
  pensiun
  wafat
}

enum RtlStatus {
  pending
  disetujui
  ditolak
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum CourseMode {
  offline // Course Tatap Muka
  online  // Course Mandiri
}

enum EvaluationType {
  pre_test    // Pre-Test Pelatihan
  post_test   // Post-Test Akhir Pelatihan
  module_eval // Evaluasi per Modul (Kuis Modul)
}

// ==========================================
// TABEL DATABASE (MODELS)
// ==========================================

model User {
  id           String        @id @default(uuid())
  nama         String
  email        String        @unique
  password     String
  role         Role          @default(guru)
  status       UserStatus    @default(aktif) @map("status")
  nip          String?       @unique @map("nip")
  sekolah      String?       @map("sekolah")
  
  // Relasi ke MasterSekolah untuk School-Scope Otorisasi
  schoolId     String?        @map("school_id")
  school       MasterSekolah? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  kotaKab      String?       @map("kota/kab")
  kecamatan    String?       @map("kecamatan")
  noHp         String?       @map("no_hp")
  fotoProfil   String?       @map("foto_profil")
  isVerified   Boolean       @default(false) @map("is_verified")
  otpCode      String?       @map("otp_code")
  otpExpiresAt DateTime?     @map("otp_expires_at")
  gelar        String?       @map("gelar")
  createdAt    DateTime      @default(now()) @map("created_at")

  // Relasi
  courseProgress   user_course_progress[]
  progress         user_progress[]
  answers          user_answers[]
  miniQuizAttempts MiniQuizAttempt[]
  feedbacks        Feedback[]
  comments         Comment[]
  rtlSubmissions   RtlSubmission[]
  reviewedRtls     RtlSubmission[]        @relation("TrainerRtlReviewer")
  tickets          Ticket[]               @relation("UserTickets")
  ticketReplies    TicketReply[]          @relation("UserTicketReplies")
  notifications    Notification[]
  certificates     Certificate[]
  createdCourses   Course[]               @relation("UserCreatedCourses")

  @@index([schoolId])
  @@map("users")
}

model Course {
  id             String      @id @default(uuid())
  judul          String
  deskripsi      String      @db.Text
  coverUrl       String?     @map("cover_url")
  mode           CourseMode  @default(online)
  hasCertificate Boolean     @default(true) @map("has_certificate")
  
  // Scope & Ownership
  // Jika schoolId = null -> GLOBAL (Dapat diakses oleh semua sekolah & guru)
  // Jika schoolId terisi -> SCOPE SEKOLAH (Khusus untuk pengajar & guru di sekolah terkait)
  schoolId       String?        @map("school_id")
  school         MasterSekolah? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  
  createdBy      String?        @map("created_by") // User ID pembuat course
  creator        User?          @relation("UserCreatedCourses", fields: [createdBy], references: [id], onDelete: SetNull)

  // Detail khusus jika mode Offline
  lokasi         String?
  tanggalMulai   DateTime?   @map("tanggal_mulai")
  tanggalSelesai DateTime?   @map("tanggal_selesai")

  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relasi
  modules        Module[]
  courseProgress user_course_progress[]
  certificates   Certificate[]

  @@index([schoolId])
  @@index([createdBy])
  @@map("courses")
}

model Module {
  id               String            @id @default(uuid())
  courseId         String?           @map("course_id") // Optional jika modul belum dimasukkan ke course
  judul            String
  deskripsi        String            @db.Text
  aspekPancawaluya AspekPancawaluya? @default(umum) @map("aspek_pancawaluya")
  urutan           Int
  createdAt        DateTime          @default(now()) @map("created_at")

  // Relasi
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contents       Content[]
  evaluations    Evaluation[]
  progress       user_progress[]
  feedbacks      Feedback[]
  rtlSubmissions RtlSubmission[]
  comments       Comment[]

  @@index([courseId])
  @@map("modules")
}

model Content {
  id        String      @id @default(uuid())
  moduleId  String      @map("module_id")
  judul     String
  tipe      ContentType
  konten    String      @db.Text
  urutan    Int
  createdAt DateTime    @default(now()) @map("created_at")

  // Relasi
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  miniQuizzes MiniQuiz[]

  @@index([moduleId])
  @@map("contents")
}

model Evaluation {
  id           String         @id @default(uuid())
  moduleId     String?        @map("module_id") // Nullable jika evaluasi tingkat global
  judul        String
  tipe         EvaluationType @default(module_eval)
  passingScore Int            @default(80) @map("passing_score")
  maxAttempts  Int            @default(3) @map("max_attempts")
  createdAt    DateTime       @default(now()) @map("created_at")

  // Relasi
  module    Module?    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([moduleId])
  @@index([tipe])
  @@map("evaluations")
}

model Question {
  id           String       @id @default(uuid())
  evaluationId String       @map("evaluation_id")
  pertanyaan   String       @db.Text
  tipe         QuestionType @default(pilihan_ganda)
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relasi
  evaluation Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  options    Option[]
  answers    user_answers[]

  @@index([evaluationId])
  @@map("questions")
}

model Option {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  teksOpsi   String  @map("teks_opsi") @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  // Relasi
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("options")
}

model user_course_progress {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  courseId    String         @map("course_id")
  status      ProgressStatus @default(belum_mulai)
  completedAt DateTime?      @map("completed_at")

  // Relasi
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("user_course_progress")
}

model user_progress {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  moduleId    String         @map("module_id")
  status      ProgressStatus @default(belum_mulai)
  preTestSkor Int?           @default(0) @map("pre_test_skor")
  skor        Int?           @default(0) // Skor post-test / evaluasi utama
  attempts    Int            @default(0)
  completedAt DateTime?      @map("completed_at")

  // Relasi
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("user_progress")
}

model user_answers {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  jawaban    String   @db.Text
  isCorrect  Boolean? @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("user_answers")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  saran     String   @db.Text
  kritik    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moduleId])
  @@map("feedbacks")
}

model Comment {
  id        String   @id @default(uuid())
  moduleId  String   @map("module_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  komentar  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi
  module  Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([moduleId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model RtlSubmission {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  moduleId       String    @map("module_id")
  filePdfUrl     String    @map("file_pdf_url") @db.Text
  catatanGuru    String?   @map("catatan_guru") @db.Text
  status         RtlStatus @default(pending)
  catatanTrainer String?   @map("catatan_trainer") @db.Text
  reviewedById   String?   @map("reviewed_by_id")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relasi
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("TrainerRtlReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("rtl_submissions")
}

model Certificate {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  courseId        String   @map("course_id")
  nomorSertifikat String   @unique @map("nomor_sertifikat")
  fileUrl         String   @map("file_url") @db.Text
  issuedAt        DateTime @default(now()) @map("issued_at")

  // Relasi
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

model MiniQuiz {
  id               String   @id @default(uuid())
  contentId        String   @map("content_id")
  judul            String
  timestampSeconds Int?     @map("timestamp_seconds")
  passingScore     Int      @default(80) @map("passing_score")
  maxAttempts      Int      @default(3) @map("max_attempts")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relasi
  content   Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  questions MiniQuizQuestion[]
  attempts  MiniQuizAttempt[]

  @@index([contentId])
  @@map("mini_quizzes")
}

model MiniQuizQuestion {
  id         String   @id @default(uuid())
  miniQuizId String   @map("mini_quiz_id")
  pertanyaan String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relasi
  miniQuiz MiniQuiz         @relation(fields: [miniQuizId], references: [id], onDelete: Cascade)
  options  MiniQuizOption[]

  @@index([miniQuizId])
  @@map("mini_quiz_questions")
}

model MiniQuizOption {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  teksOpsi   String  @map("teks_opsi") @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  // Relasi
  question MiniQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("mini_quiz_options")
}

model MiniQuizAttempt {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  miniQuizId    String   @map("mini_quiz_id")
  attemptNumber Int      @map("attempt_number")
  skor          Int
  isLolos       Boolean  @map("is_lolos")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relasi
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  miniQuiz MiniQuiz @relation(fields: [miniQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, miniQuizId, attemptNumber])
  @@index([userId])
  @@index([miniQuizId])
  @@map("mini_quiz_attempts")
}

model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String       @unique @map("ticket_number")
  userId       String       @map("user_id")
  subject      String
  category     String
  description  String       @db.Text
  status       TicketStatus @default(open)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user    User          @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  @@index([userId])
  @@map("tickets")
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  senderId  String   @map("sender_id")
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation("UserTicketReplies", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_replies")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  linkUrl   String?  @map("link_url")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model MasterSekolah {
  id            String   @id @default(uuid())
  npsn          String?  @unique @map("npsn")
  nama          String   @map("nama_sekolah")
  bentuk        String?  @default("SMA")
  kotaKab       String   @map("kota_kab")
  kecamatan     String?  @map("kecamatan")
  desaKelurahan String?  @map("desa_kelurahan")
  status        String?  @map("status")
  akreditasi    String?  @map("akreditasi")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relasi ke User dan Course
  users         User[]
  courses       Course[]

  @@map("master_sekolah")
}

model MasterGuru {
  id          String   @id @default(uuid())
  nip         String   @unique @map("nip")
  namaGuru    String   @map("nama_guru")
  npsnSekolah String   @map("npsn_sekolah")
  namaSekolah String   @map("nama_sekolah")
  kotaKab     String   @map("kota_kab")
  kecamatan   String?  @map("kecamatan")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("master_guru")
}